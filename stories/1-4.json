  "explanations": {
    "1": "表示厨房的里面，用方位名词“里”。",
    "2": "连接修饰语和中心语，表示妈妈做的包子。",
    "3": "表示小明也吃了包子，用关联副词“也”。",
    "4": "修饰量词“个”表示两个包子，用数字“两”。",
    "5": "表示早饭之后的时间，用方位名词“后”。",
    "6": "否定“远”，表示离家不远，用否定副词“不”。",
    "7": "表示三只猫，用数字“三”加量词“只”。",
    "8": "表示猫在树的下面睡觉，用方位名词“下”。",
    "9": "指代正在说的这只猫，用指示代词“这”。",
    "10": "小丽问小明早上吃了什么东西，用疑问代词“什么”。",
    "11": "小明问小丽是否吃了早饭，用疑问语气助词“吗”。",
    "12": "表示动作或状态持续到目前还没有改变，用关联副词“还”。",
    "13": "否定“吃”的动作尚未发生，用否定副词“没”。",
    "14": "表示建议小丽现在去吃早饭，用语气助词“吧”。",
    "15": "表示上课的动作正在进行，用时间副词“正在”。",
    "16": "老师问哪个同学会读汉字，用疑问代词“谁”。",
    "17": "问是否具备读汉字的能力，用能愿动词“会”。",
    "18": "表示读了一遍，用数字“一”加动量词“遍”。",
    "19": "表示高兴的程度很高，用程度副词“非常”。",
    "20": "表示小明和小丽共同吃午饭，用协同副词“一起”。"
